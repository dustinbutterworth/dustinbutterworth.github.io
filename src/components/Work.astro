---
const projects = [
  {
    name: 'CloudSecLists',
    href: 'https://github.com/dustinbutterworth/CloudSecLists',
    blurb: 'Curated tooling references for securing cloud environments.',
  },
  {
    name: 'OpenCTI Terraform',
    href: 'https://github.com/dustinbutterworth/opencti-terraform',
    blurb: 'Infrastructure as code for deploying OpenCTI across AWS, Azure, and GCP.',
  },
  {
    name: 'DockerHub Image Scraper',
    href: 'https://github.com/dustinbutterworth/dockerhub-image-scraper',
    blurb: 'Inventory recent images and tags from Docker Hub profiles via the API.',
  },
  {
    name: 'AWS Route53 Dump',
    href: 'https://github.com/dustinbutterworth/aws-route53-dump',
    blurb: 'Export Route53 records to CSV for review and audit workflows.',
  },
];
---

<section class="section work" id="work">
  <div class="wrap">
    <div class="reveal">
      <p class="section-label">Selected work</p>
      <h2 class="section-title">Public projects</h2>
      <p class="section-lead">
        A sample of open-source and personal tooling. Day-job delivery stays
        inside the organizations I support.
      </p>
    </div>
    <ul class="work__list">
      {
        projects.map((project, i) => (
          <li class="work__item reveal" style={`transition-delay: ${i * 70}ms`}>
            <a href={project.href} rel="noopener noreferrer" target="_blank">
              <span class="work__name">{project.name}</span>
              <span class="work__blurb">{project.blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .work {
    background: var(--paper-elevated);
    border-block: 1px solid var(--line);
  }

  .work__list {
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .work__item a {
    display: grid;
    gap: 0.35rem;
    padding: 1.15rem 1.25rem;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--line);
    background: var(--paper);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .work__item a:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
    color: inherit;
  }

  .work__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--ink);
  }

  .work__blurb {
    color: var(--ink-soft);
    font-size: 0.98rem;
  }
</style>
