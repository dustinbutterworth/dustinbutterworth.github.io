---

---

<section class="hero" id="top" aria-label="Introduction">
  <div class="hero__media" aria-hidden="true"></div>
  <div class="hero__veil" aria-hidden="true"></div>
  <div class="wrap hero__content">
    <p class="hero__eyebrow anim-fade">Senior Security Engineer</p>
    <h1 class="hero__name anim-rise">Dustin Butterworth</h1>
    <p class="hero__lede anim-rise anim-delay-1">
      Cloud security, detection engineering, and AI application security—built
      with automation and clear engineering judgment.
    </p>
    <div class="hero__actions anim-rise anim-delay-2">
      <a class="btn btn--primary" href="/resume.pdf">Download resume</a>
      <a class="btn btn--ghost" href="mailto:dustin.butterworth@protonmail.com"
        >Email</a
      >
      <a
        class="btn btn--ghost"
        href="https://github.com/dustinbutterworth"
        rel="noopener noreferrer"
        target="_blank">GitHub</a
      >
      <a
        class="btn btn--ghost"
        href="https://www.linkedin.com/in/dustinbutterworth/"
        rel="noopener noreferrer"
        target="_blank">LinkedIn</a
      >
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(100vh, 52rem);
    display: grid;
    align-items: end;
    color: #fff;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    background:
      url('/images/night-landscape.jpg') center / cover no-repeat;
    transform: scale(1.02);
    animation: fade 1.4s ease both;
  }

  .hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(8, 14, 22, 0.45) 0%, var(--hero-veil) 55%, #0e1520 100%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding: 8rem 0 4.5rem;
    max-width: 48rem;
  }

  .hero__eyebrow {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }

  .hero__name {
    margin: 0 0 1rem;
    font-size: clamp(2.8rem, 8vw, 5.2rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: #fff;
    max-width: 12ch;
  }

  .hero__lede {
    margin: 0 0 1.75rem;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.88);
    max-width: 36rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.65rem 1.15rem;
    border-radius: 0.35rem;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .btn--primary {
    background: var(--accent);
    color: #fff;
    border: 1px solid var(--accent);
  }

  .btn--primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    color: #fff;
  }

  .btn--ghost {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.4);
  }

  .btn--ghost:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }
</style>
