---
const links = [
  { href: '#about', label: 'About' },
  { href: '#focus', label: 'Focus' },
  { href: '#work', label: 'Work' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-header__brand" href="#top">Dustin Butterworth</a>
    <nav class="site-header__nav" aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))
      }
      <a class="site-header__resume" href="/resume.pdf">Resume</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    padding: 1.25rem 0;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-header__brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.02em;
    color: #fff;
    text-decoration: none;
  }

  .site-header__brand:hover {
    color: #fff;
    opacity: 0.85;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem 1.1rem;
    align-items: center;
  }

  .site-header__nav a {
    color: rgba(255, 255, 255, 0.86);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
  }

  .site-header__nav a:hover {
    color: #fff;
  }

  .site-header__resume {
    border: 1px solid rgba(255, 255, 255, 0.45);
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
  }

  .site-header__resume:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 640px) {
    .site-header__brand {
      font-size: 0.95rem;
    }

    .site-header__nav a:not(.site-header__resume) {
      display: none;
    }
  }
</style>
